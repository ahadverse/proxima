    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.0",
    "pino-pretty": "^13.2.0",
    "tsup": "8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
